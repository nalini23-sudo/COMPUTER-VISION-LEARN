CUSTOM GRID OF IMAGES
import cv2

# Read images
img1 = cv2.imread("image1.jpg")
img2 = cv2.imread("image2.jpg")
img3 = cv2.imread("image3.jpg")
img4 = cv2.imread("image4.jpg")

# Resize all images to the same size
size = (300, 300)
img1 = cv2.resize(img1, size)
img2 = cv2.resize(img2, size)
img3 = cv2.resize(img3, size)
img4 = cv2.resize(img4, size)

# Create top and bottom rows
top = cv2.hconcat([img1, img2])
bottom = cv2.hconcat([img3, img4])

# Create 2x2 grid
grid = cv2.vconcat([top, bottom])

# Display grid
cv2.imshow("Custom Grid", grid)

cv2.waitKey(0)
cv2.destroyAllWindows()


