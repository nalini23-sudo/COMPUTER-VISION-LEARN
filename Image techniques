IMAGE THRESHOLDING

import cv2

# Read image in grayscale
image = cv2.imread("NASA.jpg", 0)

# Apply binary threshold
ret, thresh = cv2.threshold(image, 127, 255, cv2.THRESH_BINARY)

# Save output image
cv2.imwrite("threshold_image.jpg", thresh)

# Display images
cv2.imshow("Original Image", image)
cv2.imshow("Threshold Image", thresh)

cv2.waitKey(0)
cv2.destroyAllWindows()


DRAW SHAPES

import cv2
import numpy as np

# Create a blank black image
image = np.zeros((500, 500, 3), dtype="uint8")

# Draw a line
cv2.line(image, (50, 50), (450, 50), (255, 0, 0), 3)

# Draw a rectangle
cv2.rectangle(image, (50, 100), (200, 250), (0, 255, 0), 3)

# Draw a circle
cv2.circle(image, (350, 175), 60, (0, 0, 255), 3)

# Draw an ellipse
cv2.ellipse(image, (250, 350), (100, 50), 0, 0, 360, (255, 255, 0), 3)

# Display image
cv2.imshow("Shapes", image)

cv2.waitKey(0)
cv2.destroyAllWindows()

ANNOTATING IMAGES

