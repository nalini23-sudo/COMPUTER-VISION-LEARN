import cv2

# Read image
image = cv2.imread("NASA.jpg")

# Get image height and width
(h, w) = image.shape[:2]

# Find center of image
center = (w // 2, h // 2)

# Rotate 45 degrees and scale by 1.5
matrix = cv2.getRotationMatrix2D(center, 45, 1.5)

# Apply rotation and scaling
output = cv2.warpAffine(image, matrix, (w, h))

# Save output image
cv2.imwrite("rotated_scaled.jpg", output)

# Display images
cv2.imshow("Original Image", image)
cv2.imshow("Rotated and Scaled Image", output)

cv2.waitKey(0)
cv2.destroyAllWindows()
